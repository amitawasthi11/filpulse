# ============================================
# FinPulse Backend Environment Variables
# ============================================
# Copy this file to .env and fill in your values

# Server
PORT=5000
NODE_ENV=development

# Database (MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=finpulse_db

# JWT
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_REFRESH_SECRET=your_refresh_secret_key_change_this_too
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# AI - Google Gemini (Free tier available at aistudio.google.com)
GEMINI_API_KEY=your_gemini_api_key_here

# News API (Free at newsapi.org - 100 requests/day free tier)
NEWS_API_KEY=your_newsapi_key_here

# Finnhub API (Free at finnhub.io - for stock prices)
FINNHUB_API_KEY=your_finnhub_api_key_here

# Email (Optional - for alerts)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_gmail@gmail.com
EMAIL_PASS=your_app_password

# Redis (Optional - for caching)
REDIS_URL=redis://localhost:6379

# Frontend URL (for CORS)
CLIENT_URL=http://localhost:5173
